/** One day's energy record (an object stored in the records array). */
class DailyRecord {
    private String date;        // e.g. 2026-09-28
    private double generated;   // kWh produced by the panels
    private double consumed;    // kWh used by the home

    DailyRecord(String date, double generated, double consumed) {
        this.date = date;
        this.generated = generated;
        this.consumed = consumed;
    }

    String getDate()       { return date; }
    double getGenerated()  { return generated; }
    double getConsumed()   { return consumed; }

    /** Solar energy left over after the home's needs (0 if none). */
    double getSurplus() {
        return generated > consumed ? generated - consumed : 0;
    }

    /** Energy the home had to draw from the grid (0 if none). */
    double getGridImport() {
        return consumed > generated ? consumed - generated : 0;
    }

    /** Portion of solar energy used directly by the home. */
    double getSelfUsed() {
        return Math.min(generated, consumed);
    }

    String toCsv() {
        return date + "," + generated + "," + consumed;
    }
}

/** Holds all records and does the calculations and file handling. */
class EnergyMonitor {
    private DailyRecord[] records = new DailyRecord[10];
    private int count = 0;
    private double tariff = 7.0;       // Rs saved per kWh of solar used at home
    private double exportRate = 3.0;   // Rs earned per kWh of surplus sent to grid

    int getCount()             { return count; }
    double getTariff()         { return tariff; }
    double getExportRate()     { return exportRate; }
    void setTariff(double t)   { tariff = t; }
    void setExportRate(double r) { exportRate = r; }

    /** Adds a record; grows the array when it is full. Returns false if the date already exists. */
    boolean addRecord(DailyRecord r) {
        for (int i = 0; i < count; i++) {
            if (records[i].getDate().equals(r.getDate())) {
                return false;
            }
        }
        if (count == records.length) {
            DailyRecord[] bigger = new DailyRecord[records.length * 2];
            for (int i = 0; i < count; i++) {
                bigger[i] = records[i];
            }
            records = bigger;
        }
        records[count++] = r;
        return true;
    }

    void printRecords() {
        if (count == 0) {
            System.out.println("No records yet. Choose option 1 to add one.");
            return;
        }
        System.out.println();
        System.out.printf("%-12s %12s %12s %12s %12s%n",
                "Date", "Generated", "Consumed", "Surplus", "Grid import");
        System.out.println("-------------------------------------------------------------------");
        for (int i = 0; i < count; i++) {
            DailyRecord r = records[i];
            System.out.printf("%-12s %9.2f kWh %9.2f kWh %9.2f kWh %9.2f kWh%n",
                    r.getDate(), r.getGenerated(), r.getConsumed(),
                    r.getSurplus(), r.getGridImport());
        }
    }

    void printSummary() {
        if (count == 0) {
            System.out.println("No records yet. Choose option 1 to add one.");
            return;
        }
        double totalGen = 0, totalCons = 0, totalSurplus = 0, totalSelf = 0;
        int best = 0, worst = 0;

        for (int i = 0; i < count; i++) {
            DailyRecord r = records[i];
            totalGen += r.getGenerated();
            totalCons += r.getConsumed();
            totalSurplus += r.getSurplus();
            totalSelf += r.getSelfUsed();
            if (r.getGenerated() > records[best].getGenerated())  best = i;
            if (r.getGenerated() < records[worst].getGenerated()) worst = i;
        }

        double savings = totalSelf * tariff + totalSurplus * exportRate;
        double solarShare = totalCons > 0 ? totalSelf / totalCons * 100 : 0;

        System.out.println();
        System.out.println("========== Solar Energy Report ==========");
        System.out.println("Days recorded            : " + count);
        System.out.printf("Total generated          : %.2f kWh%n", totalGen);
        System.out.printf("Total consumed           : %.2f kWh%n", totalCons);
        System.out.printf("Total surplus            : %.2f kWh%n", totalSurplus);
        System.out.printf("Average generation / day : %.2f kWh%n", totalGen / count);
        System.out.printf("Solar share of home use  : %.1f %%%n", solarShare);
        System.out.printf("Best day                 : %s (%.2f kWh)%n",
                records[best].getDate(), records[best].getGenerated());
        System.out.printf("Lowest day               : %s (%.2f kWh)%n",
                records[worst].getDate(), records[worst].getGenerated());
        System.out.printf("Estimated savings        : Rs %.2f%n", savings);

        if (solarShare >= 100) {
            System.out.println("Status: Your solar system covers all of your home's use.");
        } else if (solarShare >= 50) {
            System.out.println("Status: Solar covers most of your use. Shifting heavy loads to daytime will help.");
        } else {
            System.out.println("Status: Solar covers under half of your use. Consider daytime appliance use.");
        }
        System.out.println("=========================================");
    }

    /** Saves tariff settings and all records to a text file. */
    void save(String fileName) throws IOException {
        try (PrintWriter out = new PrintWriter(new FileWriter(fileName))) {
            out.println("#settings," + tariff + "," + exportRate);
            for (int i = 0; i < count; i++) {
                out.println(records[i].toCsv());
            }
        }
    }

    /** Loads records from a file if it exists. Returns number of records loaded. */
    int load(String fileName) throws IOException {
        File f = new File(fileName);
        if (!f.exists()) {
            return 0;
        }
        int loaded = 0;
        try (BufferedReader in = new BufferedReader(new FileReader(f))) {
            String line;
            while ((line = in.readLine()) != null) {
                String[] p = line.trim().split(",");
                try {
                    if (p[0].equals("#settings") && p.length == 3) {
                        tariff = Double.parseDouble(p[1]);
                        exportRate = Double.parseDouble(p[2]);
                    } else if (p.length == 3) {
                        if (addRecord(new DailyRecord(p[0],
                                Double.parseDouble(p[1]), Double.parseDouble(p[2])))) {
                            loaded++;
                        }
                    }
                } catch (NumberFormatException e) {
                    // skip a damaged line and keep reading
                }
            }
        }
        return loaded;
    }
}

public class SolarMonitor {
    private static final String DATA_FILE = "solar_records.csv";
    private static final Scanner sc = new Scanner(System.in);

    static double readNumber(String prompt) {
        while (true) {
            System.out.print(prompt);
            String s = sc.nextLine().trim();
            try {
                double v = Double.parseDouble(s);
                if (v < 0) {
                    System.out.println("Please enter a value of 0 or more.");
                } else {
                    return v;
                }
            } catch (NumberFormatException e) {
                System.out.println("That is not a number. Try again.");
            }
        }
    }

    static String readDate() {
        while (true) {
            System.out.print("Date (YYYY-MM-DD): ");
            String s = sc.nextLine().trim();
            if (s.matches("\\d{4}-\\d{2}-\\d{2}")) {
                return s;
            }
            System.out.println("Use the format YYYY-MM-DD, for example 2026-09-28.");
        }
    }

    static void printMenu() {
        System.out.println();
        System.out.println("---- Rooftop Solar Energy Monitor ----");
        System.out.println("1. Add daily record");
        System.out.println("2. View all records");
        System.out.println("3. Show summary report");
        System.out.println("4. Change tariff / export rate");
        System.out.println("5. Save and exit");
        System.out.print("Choose an option (1-5): ");
    }

    public static void main(String[] args) {
        EnergyMonitor monitor = new EnergyMonitor();

        try {
            int n = monitor.load(DATA_FILE);
            if (n > 0) System.out.println("Loaded " + n + " saved record(s).");
        } catch (IOException e) {
            System.out.println("Could not read saved data: " + e.getMessage());
        }

        boolean running = true;
        while (running) {
            printMenu();
            String choice = sc.nextLine().trim();

            switch (choice) {
                case "1":
                    String date = readDate();
                    double gen = readNumber("Energy generated (kWh): ");
                    double cons = readNumber("Energy consumed (kWh): ");
                    if (monitor.addRecord(new DailyRecord(date, gen, cons))) {
                        System.out.println("Record added.");
                    } else {
                        System.out.println("A record for " + date + " already exists.");
                    }
                    break;
                case "2":
                    monitor.printRecords();
                    break;
                case "3":
                    monitor.printSummary();
                    break;
                case "4":
                    monitor.setTariff(readNumber("Rs saved per kWh of solar used at home (now "
                            + monitor.getTariff() + "): "));
                    monitor.setExportRate(readNumber("Rs earned per kWh sent to grid (now "
                            + monitor.getExportRate() + "): "));
                    System.out.println("Rates updated.");
                    break;
                case "5":
                    try {
                        monitor.save(DATA_FILE);
                        System.out.println("Saved " + monitor.getCount() + " record(s) to " + DATA_FILE + ". Goodbye!");
                    } catch (IOException e) {
                        System.out.println("Could not save data: " + e.getMessage());
                    }
                    running = false;
                    break;
                default:
                    System.out.println("Please enter a number from 1 to 5.");
            }
        }
    }
}
